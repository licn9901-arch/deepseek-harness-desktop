{
  "schemaVersion": 2,
  "dshVersion": "0.1.1-rc.2",
  "sharedPackages": [
    "@deepseek-ai/*",
    "cordis",
    "react",
    "react-dom"
  ],
  "plugins": [
    {
      "package": "@dsh-desktop/runtime-services",
      "version": "0.1.0-preview.14",
      "bundleId": "desktop-runtime-services",
      "license": "MIT",
      "source": {
        "type": "local",
        "path": "desktop-plugins/runtime-services"
      },
      "requiredFiles": [
        "lib/index.js",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": [],
        "assets": ["cordis.patch.yml"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "为 Market 提供固定 web profile 与串行包管理服务",
        "始终使用内置 pnpm 10；仅在明确的 modules/hoist 不兼容时执行一次事务式重建"
      ]
    },
    {
      "package": "@omdsh-dev/dsh-genui",
      "version": "0.8.6",
      "bundleId": "@omdsh-dev/dsh-genui",
      "license": "MIT",
      "source": {
        "type": "github-tarball",
        "repository": "omdsh-dev/dsh-genui",
        "tag": "v0.8.6",
        "commit": "2187fa48dfb05126850d3a1516be910718afdc79",
        "url": "https://api.github.com/repos/omdsh-dev/dsh-genui/tarball/v0.8.6",
        "sha256": "6ef84b7237910254a287070e9505d5ed8340edce8f7ca3be5afa25e25a221b98",
        "archive": "dsh-genui-v0.8.6.tar.gz"
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "lib/assets/mermaid.js",
        "lib/assets/three.js",
        "cordis.patch.yml",
        "SKILL.md",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["lib/assets/mermaid.js", "lib/assets/three.js", "cordis.patch.yml", "SKILL.md"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "在回答中渲染交互式 UI、Mermaid 和 Three.js",
        "将 GenUI action 事件作为消息回传模型"
      ]
    },
    {
      "package": "dsh-better-sidebar",
      "version": "0.15.0",
      "bundleId": "dsh-better-sidebar",
      "license": "MIT",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-9Ox7wvwhBRlgMIxVRKqar26eRp1GnAAOO5a0QrxydpUbuJdBIpUFOHGcAI+xX6ddJGwAdELFdMsyMWAtJEhAUQ=="
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js", "lib/client-editor.js", "lib/client-registry.js", "lib/client-terminal.js"],
        "assets": ["lib/invariant.js", "cordis.patch.yml"],
        "runtimeExternals": ["schemastery", "ws"],
        "nativeExternals": ["node-pty"],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "读写工作区文件并执行 Git 操作",
        "启动和控制本机 PTY 终端",
        "提供网页预览；桌面托管安装默认关闭 HTTP/HTTPS 接管"
      ]
    },
    {
      "package": "@dsh-desktop/settings",
      "version": "0.1.0-preview.14",
      "bundleId": "desktop-settings",
      "license": "MIT",
      "source": {
        "type": "local",
        "path": "desktop-plugins/settings"
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["cordis.patch.yml"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "原子切换精确白名单中的桌面托管 bundle，不修改依赖或卸载文件",
        "配置 Hindsight 服务、凭据状态和项目级显式启用",
        "默认安装但允许用户卸载，卸载时保留用户配置"
      ]
    },
    {
      "package": "@linxin666/dsh-client-ui-skin-center",
      "version": "0.2.7",
      "bundleId": "ui-skin-center",
      "license": "Apache-2.0",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-QyY1s3gdlXagC5mYHTgiBUj2J0u6z1wjaPn/TQXB6y+2+TBhrMPFHmZpmwq2RE8dy0cc4E2MlHX10IwX8lPWfw=="
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "contracts",
        "skins",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["cordis.patch.yml", "contracts", "skins"],
        "runtimeExternals": ["schemastery"],
        "nativeExternals": ["lightningcss"],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "加载内置皮肤与 $DSH_HOME/skins 下的用户皮肤",
        "在页面内试穿、应用和恢复皮肤，并写入 $DSH_HOME/skin-center-active.json",
        "读取用户显式选择的 Wallpaper Engine 或本机媒体目录作为背景"
      ]
    },
    {
      "package": "@vectorize-io/hindsight-coding-agents",
      "version": "0.4.1",
      "bundleId": "hindsight-coding-agents",
      "license": "MIT",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-kJxvHFOWalfDg7xtAuPGMRJ/v8pTGulA+8g54H/nXOjcXnqdOy/qE2EupAJaN5VCWf152Ps/X/LjXc4UVG0tSw=="
      },
      "requiredFiles": [
        "dist/dsh.js",
        "cordis.patch.yml",
        "skill/SKILL.md"
      ],
      "delivery": {
        "serverEntries": ["dist/dsh.js"],
        "clientEntries": [],
        "assets": ["cordis.patch.yml", "skill/SKILL.md"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["package.json"]
      },
      "permissions": [
        "仅对用户显式 opt-in 的 DSH 项目执行记忆 retain/recall",
        "连接用户后续配置的 Hindsight 服务"
      ]
    },
    {
      "package": "@cubee-slide/skills-mcp-manager",
      "version": "0.2.4",
      "bundleId": "skills-mcp-manager",
      "license": "MIT",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-N94gaY8ropqRNCKKO3Ff4IFIQu+EcbKC3Vrl9WFzlGxb1QnJq6H8TVMyVJaM/ir+6riuML2A2YxcBVsQeQbFAw=="
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["cordis.patch.yml"],
        "runtimeExternals": ["schemastery"],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "列出、启用、停用和删除 DSH Skills",
        "读写 ~/.dsh/mcp.json 并管理 MCP 连接"
      ]
    }
  ],
  "transitivePackages": [],
  "skills": [
    {
      "name": "genui",
      "sourcePackage": "@omdsh-dev/dsh-genui",
      "sourceFile": "SKILL.md",
      "version": "0.8.6",
      "sha256": "052681f96898450e25c8080a532f48d2e57ce72d5bbdcbe05d23ca22b79beb2f"
    }
  ]
}
