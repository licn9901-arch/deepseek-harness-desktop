        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js", "lib/client-editor.js", "lib/client-registry.js", "lib/client-terminal.js", "lib/client-mermaid.js"],
