  "transitivePackages": [],
  "skills": [
    {
      "name": "genui",
      "sourcePackage": "@changfenhuang/dsh-genui",
      "sourceFile": "SKILL.md",
      "version": "0.9.6",
      "sha256": "9a8a6250e527e4bca3f98c32d7e7156f6df344fee641a79bd94291771085368f"
    }
  ]
