        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-9SjMsKTBqgszc5W8h+amNl3M6mzqZhckJlLfXZNLUgYpLMdOQRbmxb9yy42jofiIoaTEYxCn4m4ArnlSiUrxWA=="
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "contracts",
        "skins",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["cordis.patch.yml", "contracts", "skins"],
        "runtimeExternals": ["schemastery"],
        "nativeExternals": ["lightningcss"],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "加载内置皮肤与 $DSH_HOME/skins 下的用户皮肤",
        "在页面内试穿、应用和恢复皮肤，并写入 $DSH_HOME/skin-center-active.json",
        "读取用户显式选择的 Wallpaper Engine 或本机媒体目录作为背景"
      ]
    },
    {
      "package": "@vectorize-io/hindsight-coding-agents",
      "version": "0.4.3",
      "bundleId": "hindsight-coding-agents",
      "license": "MIT",
      "source": {
        "type": "npm",
        "registry": "https://registry.npmjs.org/",
        "integrity": "sha512-Vdw2tiv17lB5SW7qNmT6PKJHC7eDTBBcW8QBBJH7QpiIsEFgPkCg5TvR+Gt1clgYmViKqpWxzR8OJh9l6YVkRQ=="
      },
