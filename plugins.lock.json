{
  "schemaVersion": 2,
  "dshVersion": "0.1.2-alpha.2",
  "sharedPackages": [
    "@deepseek-ai/*",
    "cordis",
    "react",
    "react-dom"
  ],
  "plugins": [
    {
      "package": "@dsh-desktop/runtime-services",
      "version": "0.1.0-preview.14",
      "bundleId": "desktop-runtime-services",
      "license": "MIT",
      "source": {
        "type": "local",
        "path": "desktop-plugins/runtime-services"
      },
      "requiredFiles": [
        "lib/index.js",
        "cordis.patch.yml",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": [],
        "assets": ["cordis.patch.yml"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
      },
      "permissions": [
        "为 Market 提供固定 web profile 与串行包管理服务",
        "始终使用内置 pnpm 10；仅在明确的 modules/hoist 不兼容时执行一次事务式重建"
      ]
    },
    {
      "package": "@changfenhuang/dsh-genui",
      "version": "0.9.6",
      "bundleId": "@changfenhuang/dsh-genui",
      "license": "MIT",
      "source": {
        "type": "github-tarball",
        "repository": "omdsh-dev/dsh-genui",
        "tag": "v0.9.6",
        "commit": "d8e82c59cfb5b966dedf2a30911a0fa2c0844182",
        "url": "https://api.github.com/repos/omdsh-dev/dsh-genui/tarball/v0.9.6",
        "sha256": "331de8d131d34efbe452845d18315ccd72385531af2e16078f4a0d31f4cd24e6",
        "archive": "dsh-genui-v0.9.6.tar.gz"
      },
      "requiredFiles": [
        "lib/index.js",
        "lib/client.js",
        "lib/assets/mermaid.js",
        "lib/assets/three.js",
        "lib/assets/echarts.js",
        "cordis.patch.yml",
        "SKILL.md",
        "LICENSE"
      ],
      "delivery": {
        "serverEntries": ["lib/index.js"],
        "clientEntries": ["lib/client.js"],
        "assets": ["lib/assets/mermaid.js", "lib/assets/three.js", "lib/assets/echarts.js", "cordis.patch.yml", "SKILL.md"],
        "runtimeExternals": [],
        "nativeExternals": [],
        "licenseFiles": ["LICENSE"]
